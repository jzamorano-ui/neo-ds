{
  "name": "@neo-design/foundations",
  "version": "1.0.0",
  "description": "Neo — the system foundations: semantic tokens in JS and CSS, icons and the plain CSS layer. It does not depend on React or Material UI.",
  "homepage": "https://github.com/jzamorano-ui/neo-ds/blob/main/docs/dev/INTEGRATION.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzamorano-ui/neo-ds.git",
    "directory": "packages/foundations"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./tokens/neo-color.css",
    "./foundations.css": "./tokens/neo-foundations.css",
    "./icons.css": "./icons/icons.css",
    "./sprite": {
      "types": "./icons/sprite.d.mts",
      "default": "./icons/sprite.mjs"
    },
    "./icons.json": "./icons/index.json",
    "./css/*": "./css/*",
    "./tokens/api-js.mjs": {
      "types": "./tokens/api-js.d.mts",
      "default": "./tokens/api-js.mjs"
    },
    "./tokens/breakpoints.mjs": {
      "types": "./tokens/breakpoints.d.mts",
      "default": "./tokens/breakpoints.mjs"
    },
    "./tokens/color-semantic.mjs": {
      "types": "./tokens/color-semantic.d.mts",
      "default": "./tokens/color-semantic.mjs"
    },
    "./tokens/color.mjs": {
      "types": "./tokens/color.d.mts",
      "default": "./tokens/color.mjs"
    },
    "./tokens/component-tokens.mjs": {
      "types": "./tokens/component-tokens.d.mts",
      "default": "./tokens/component-tokens.mjs"
    },
    "./tokens/container.mjs": {
      "types": "./tokens/container.d.mts",
      "default": "./tokens/container.mjs"
    },
    "./tokens/iconSize.mjs": {
      "types": "./tokens/iconSize.d.mts",
      "default": "./tokens/iconSize.mjs"
    },
    "./tokens/radius.mjs": {
      "types": "./tokens/radius.d.mts",
      "default": "./tokens/radius.mjs"
    },
    "./tokens/shadows.mjs": {
      "types": "./tokens/shadows.d.mts",
      "default": "./tokens/shadows.mjs"
    },
    "./tokens/spacing.mjs": {
      "types": "./tokens/spacing.d.mts",
      "default": "./tokens/spacing.mjs"
    },
    "./tokens/stroke.mjs": {
      "types": "./tokens/stroke.d.mts",
      "default": "./tokens/stroke.mjs"
    },
    "./tokens/typography.mjs": {
      "types": "./tokens/typography.d.mts",
      "default": "./tokens/typography.mjs"
    },
    "./icon-aliases.mjs": {
      "types": "./icon-aliases.d.mts",
      "default": "./icon-aliases.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "tokens",
    "icons",
    "css",
    "icon-aliases.mjs",
    "icon-aliases.d.mts",
    "!icons/svg",
    "!icons/icons.svg",
    "!icons/_demo.html"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
