{
  "name": "@neo-design/mui",
  "version": "1.0.0",
  "description": "Neo — the Material UI theme and the Neo* React components, on top of @neo-design/foundations.",
  "homepage": "https://github.com/jzamorano-ui/neo-ds/blob/main/docs/dev/INTEGRATION.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzamorano-ui/neo-ds.git",
    "directory": "packages/mui"
  },
  "type": "module",
  "types": "./ui/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./ui/index.d.ts",
      "default": "./ui/index.mjs"
    },
    "./theme": {
      "types": "./theme/index.d.ts",
      "default": "./theme/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "ui",
    "theme"
  ],
  "dependencies": {
    "@neo-design/foundations": "1.0.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/material": ">=5.18.0 <7",
    "react": "^18 || ^19"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
